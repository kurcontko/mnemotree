# Bearer/Token/X-Api-Key secret registered on agentmemoryleaderboard.ai
MNEMOTREE_API_KEY=
# Alibaba Model Studio (international/Singapore) key for text-embedding-v4
DASHSCOPE_API_KEY=
# Public hostname for the caddy profile (DNS A record -> this VM)
AML_DOMAIN=memory.example.com
# Cloudflare tunnel token for the tunnel profile
TUNNEL_TOKEN=
# Use a fresh database file for each Full run
AML_DB=aml.sqlite
# Tuned search config; defaults to the example
AML_CONFIG=./config.example.json
