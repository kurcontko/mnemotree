# Bearer/Token/X-Api-Key secret registered on agentmemoryleaderboard.ai
MNEMOTREE_API_KEY=
# Alibaba Model Studio (international/Singapore) key for text-embedding-v4
DASHSCOPE_API_KEY=
# Public hostname for the caddy profile (DNS A record -> this VM)
AML_DOMAIN=memory.example.com
# Cloudflare tunnel token for the tunnel profile
TUNNEL_TOKEN=
# Use a fresh database file for each Full run
AML_DB=aml.sqlite
# Commit being served, recorded in the startup log (the image has no Git metadata)
MNEMOTREE_BUILD_REVISION=
# Service config; config.lexical.json needs no embedding provider
AML_CONFIG=./config.example.json
# Payload capture (message and query text): empty = off. Turn it on for a Smoke run
# only, e.g. /data/logs/payloads.jsonl, and delete the file within 30 days.
AML_SAMPLE_PAYLOADS=
# Payloads captured per route while capture is on; 0 = unlimited
AML_SAMPLE_LIMIT=0
